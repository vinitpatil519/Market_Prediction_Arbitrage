# Every value here has a working default. Copy to .env only to override.

# --- storage ---------------------------------------------------------------
# Postgres in production; the default SQLite file needs no services running.
# DATABASE_URL=postgresql+asyncpg://arb:arb@localhost:5432/arbitrage
# REDIS_URL=redis://localhost:6379/0
PERSIST=true

# --- feeds -----------------------------------------------------------------
# "simulator" runs without credentials. "live" needs the keys below.
FEED_MODE=simulator
LIVE_MARKET_LIMIT=60

# Polymarket's market websocket is public: no credentials needed.
# Kalshi signs every request, so live mode needs an API key pair.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# --- simulator -------------------------------------------------------------
SIM_EVENTS=8
SIM_TICK_HZ=4
SIM_SEED=42
SIM_DISLOCATION_RATE=0.05

# --- engine ----------------------------------------------------------------
# Minimum net edge per contract pair, in dollars. 0.002 = 20 bps.
MIN_NET_EDGE=0.002
MAX_POSITION_SIZE=5000
MAX_BOOK_AGE=5

# Round-trip latency assumed between the book snapshot and the order landing.
LATENCY_MS=250
DECAY_PER_100MS=0.08
ADVERSE_TICK=0.0

BANKROLL=10000
KELLY_MULTIPLIER=0.25
MAX_FRACTION_PER_TRADE=0.20
# Expected share of the stake lost when a hedge breaks.
LOSS_FRACTION=0.5

# --- fees ------------------------------------------------------------------
KALSHI_TAKER_RATE=0.07
POLYMARKET_TAKER_RATE=0.0
POLYMARKET_GAS_COST=0.02
